ACTION: DllSelfRegister: "C:\Aplicaciones\CorEss28\CorEssdll\CorPrinterSP2.dll"

ACTION: RegKey: "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion", "App Paths\CorPrinterSP2.dll"

